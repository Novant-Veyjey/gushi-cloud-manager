# ---------- 依赖 ----------
node_modules/
**/node_modules/

# ---------- 构建产物 ----------
gushi-miniapp/dist/
gushi-miniapp/dist-h5/
dist/
dist-h5/
# Taro copy 插件会把 TabBar 图标复制到包根目录，属构建产物（源文件在 src/assets/tabbar/）
/gushi-miniapp/assets/

# ---------- 运行期数据（数据库、JWT 密钥、备份、上传图片）----------
# 数据库可通过 `cd 后台 && npm run seed:demo` 重新生成演示数据
后台/server/data/
后台/public/uploads/
**/server/data/
**/public/uploads/

# ---------- 环境变量与密钥 ----------
.env
**/.env
*secret*
!**/jwt.example*

# ---------- 日志与临时文件 ----------
# 本地临时文件（提交信息、草稿、验证脚本等）
_*.txt
# 临时验证脚本（截图验证、接口联调用的 _xxx.js）与临时 Python 脚本
_*.js
_*.py
# 生成 Word 版介绍书时的临时依赖目录
/_docxtools/
*.log
*.out.log
*.err.log
~$*
.DS_Store
Thumbs.db
*.tmp

# ---------- 部署产物与 IDE 状态 ----------
# _deploy 是 Cloud Studio 部署用的工作目录（源码与数据在 后台/ 和 gushi-miniapp/ 中）
/_deploy/
# CodeBuddy IDE 的本地状态与集成数据
.codebuddy/

{
  "name": "gushi-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "菇事云管家微信小程序（Taro + React + TypeScript），复用 Express + better-sqlite3 后台接口",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp && node scripts/copy-tabbar.js",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "cross-env TARO_OUTPUT_ROOT=dist-h5 taro build --type h5 && node scripts/copy-tabbar.js",
    "dev:h5": "cross-env TARO_OUTPUT_ROOT=dist-h5 taro build --type h5 --watch",
    "preview:h5": "node scripts/serve-h5.js",
    "type-check": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "菇事云管家项目团队",
  "dependencies": {
    "@babel/runtime": "^7.24.5",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/router": "^4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.2.1",
    "cross-env": "^10.1.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.2",
    "sass-loader": "^14.2.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0"
  }
}

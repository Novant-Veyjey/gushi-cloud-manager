{
  "name": "gushi-cloud-app",
  "version": "0.1.0",
  "private": true,
  "description": "菇事云管家：HTML 界面原型 + Express + better-sqlite3 可保存后台",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "start:env": "node --env-file=.env server/app.js",
    "dev": "node --watch server/app.js",
    "seed:demo": "node server/seed-demo.js",
    "backup": "node server/backup.js",
    "make:admin": "node server/make-admin.js",
    "mqtt:broker": "node server/mqtt-broker.js",
    "mqtt": "node server/mqtt-bridge.js",
    "test:mqtt": "node server/test-mqtt.js",
    "test": "node server/test-api.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "aedes": "^0.51.3"
  }
}

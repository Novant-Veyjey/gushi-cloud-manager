const pageMeta={home:['菇事云管家','真实业务数据管理'],production:['生产批次','菌棒与生产记录'],monitor:['环境监测','设备数据与自动预警'],trace:['质量溯源','按真实批次查看全过程'],market:['产销对接','真实供应与采购需求'],expert:['专家服务','问题与专家回复']};
function renderHome(){
 const d=state.data.dashboard||{};
 const readings=(d.latestReadings||[]).slice(0,4);
 const alerts=(d.alerts||[]).slice(0,4);
 const tasks=state.data.tasks.slice(0,4);
 return `<section class="page">
  <div class="hero"><small>GU SHI CLOUD · 真实数据可保存</small><h1>生产有记录<br><em>数据能追溯，后台能保存</em></h1><p>所有数字均来自后台数据库。没有录入数据时，系统会显示空状态，不会编造业务数据。</p><div class="hero-foot"><span class="hero-tag">基地</span><span class="hero-tag">批次</span><span class="hero-tag">监测</span><span class="hero-tag">溯源</span></div></div>
  <div class="quick"><button data-form="base"><i>＋</i><span>新增基地</span></button><button data-form="batch"><i>▤</i><span>新增批次</span></button><button data-form="reading"><i>🌡</i><span>录入环境</span></button><button data-page="expert"><i>👩‍🌾</i><span>专家服务</span></button></div>
  ${pageHead('今日数据','来自后台数据库的实时汇总')}
  <div class="stats">${stat('生产基地',d.bases??0,'处','已保存基地')}${stat('生产批次',d.batches??0,'批','已保存批次','#eff7db')}${stat('监测设备',d.devices??0,'台','按设备名称统计','#e7f0f8')}${stat('待处理预警',d.openAlerts??0,'条','自动规则生成','#fff1db')}</div>
  ${pageHead('最新环境记录','只展示已保存的真实记录',`<button data-form="reading">录入</button>`)}
  <div class="card todo">${readings.length?readings.map(reading=>`<div class="todo-row"><div class="todo-icon green">🌡</div><div class="todo-copy"><strong>${esc(reading.base_name||baseName(reading.base_id))}</strong><p>${esc(reading.device_name||'未命名设备')} · ${esc(reading.temperature??'--')}°C · 湿度 ${esc(reading.humidity??'--')}% · CO₂ ${esc(reading.co2??'--')}ppm</p></div><span class="todo-time">${esc(dateOnly(reading.recorded_at))}</span></div>`).join(''):empty('暂无环境记录','请先新增基地，再录入环境数据。')}</div>
  ${pageHead('待处理预警','环境数据保存后自动按阈值生成',`<button data-page="monitor">全部</button>`)}
  <div class="card todo">${alerts.length?alerts.map(alert=>`<div class="todo-row"><div class="todo-icon ${alert.level==='high'?'red':''}">!</div><div class="todo-copy"><strong>${esc(alert.message)}</strong><p>${esc(alert.base_name||baseName(alert.base_id))} · ${esc(alert.alert_type)}</p></div><button class="action-link" data-ack="${alert.id}">处理</button></div>`).join(''):empty('暂无待处理预警','录入环境数据后，超过阈值的记录会自动生成预警。')}</div>
  ${pageHead('生产任务','任务建议由规则引擎或 AI 生成',`<button data-form="task">新增任务</button>`)}
  <div class="card todo">${tasks.length?tasks.map(task=>`<div class="todo-row"><div class="todo-icon ${task.priority==='high'?'red':''}">${task.priority==='high'?'!':'✓'}</div><div class="todo-copy"><strong>${esc(task.title)}</strong><p>${esc(task.description||'无补充说明')} · 截止 ${esc(dateOnly(task.due_date)||'未设置')}</p></div><span class="todo-time">${esc(task.priority)}</span></div>`).join(''):empty('暂无生产任务','点击新增任务，可调用优先级建议接口。')}</div>
 </section>`
}
function renderProduction(){
 const batches=state.data.batches;
 const cards=batches.map(batch=>`<div class="card batch-card"><div class="batch-top"><div><div class="batch-code">${esc(batch.code)}</div><div class="batch-meta">${esc(baseName(batch.base_id))}<br>${esc(batch.mushroom_type)}${batch.variety?' · '+esc(batch.variety):''} · ${esc(batch.quantity)} 棒</div></div>${badge(batch.stage)}</div><div class="metric-line"><div><span>入库日期</span><b>${esc(dateOnly(batch.start_date)||'--')}</b></div><div><span>预计出菇</span><b>${esc(dateOnly(batch.expected_harvest_date)||'--')}</b></div><div><span>状态</span><b>${esc(batch.status)}</b></div></div></div>`).join('');
 return `<section class="page"><div class="toolbar"><button class="primary" data-form="batch">＋ 新增批次</button><button class="secondary" data-form="base">新增基地</button></div>${pageHead('生产批次台账','批次是生产、监测、溯源与销售的共同主线')}${batches.length?cards:empty('暂无生产批次','请先新增基地，再录入真实批次编号、菌种、数量和日期。')}</section>`
}
function renderMonitor(){
 const readings=state.data.readings.slice(0,20);
 const alerts=state.data.alerts.filter(a=>a.status==='open');
 return `<section class="page"><div class="toolbar"><button class="primary" data-form="reading">＋ 录入环境数据</button></div>${pageHead('环境数据','保存后自动判断温度、湿度和 CO₂ 阈值')}${readings.length?readings.map(r=>`<div class="card list-card"><div class="row-top"><div><h3>${esc(r.device_name||'未命名设备')}</h3><p>${esc(baseName(r.base_id))}<br>${esc(new Date(r.recorded_at).toLocaleString('zh-CN'))}</p></div>${badge('已保存')}</div><div class="metric-line"><div><span>温度</span><b>${esc(r.temperature??'--')}°C</b></div><div><span>湿度</span><b>${esc(r.humidity??'--')}%</b></div><div><span>CO₂</span><b>${esc(r.co2??'--')} ppm</b></div></div></div>`).join(''):empty('暂无环境数据','请先新增基地，再录入设备名称和环境指标。')}
 ${pageHead('待处理预警','预警由后台规则自动生成，可点击处理')}${alerts.length?`<div class="card todo">${alerts.map(a=>`<div class="todo-row"><div class="todo-icon ${a.level==='high'?'red':''}">!</div><div class="todo-copy"><strong>${esc(a.message)}</strong><p>${esc(a.base_name||baseName(a.base_id))}</p></div><button class="action-link" data-ack="${a.id}">处理</button></div>`).join('')}</div>`:empty('暂无待处理预警','环境数据超过阈值后会自动生成预警。')}</section>`
}
function renderTrace(){
 const result=state.traceResult;
 let body='<div class="notice">输入真实批次编号后查询。批次、基地、生产事件和产品信息均来自后台数据库。</div>';
 if(result){
  const events=result.events||[],products=result.products||[],batch=result.batch;
  body=`<div class="card trace-product"><div class="row-top"><div><h3>${esc(batch.mushroom_type)} · ${esc(batch.code)}</h3><p>${esc(batch.base_name||'未关联基地')} · ${esc(batch.base_address||'')}</p></div>${badge('数据库记录')}</div><div class="timeline">${events.length?events.map(e=>`<div class="event"><div class="dot done">✓</div><div><strong>${esc(e.title)}</strong><p>${esc(e.description||e.event_type)}</p></div><time>${esc(dateOnly(e.event_date))}</time></div>`).join(''):'<div class="empty">该批次暂无溯源事件</div>'}</div>${products.length?products.map(p=>`<div class="demand"><strong>${esc(p.name)}</strong><p>${esc(p.quantity)} ${esc(p.unit)} · ¥${money(p.price)}/${esc(p.unit)}</p></div>`).join(''):''}</div>`;
 }
 return `<section class="page"><div class="toolbar"><div class="search">⌕ <input id="traceCode" placeholder="输入批次编号，例如 DEMO-20260901-01" value="${esc(state.traceCode||'')}"> </div><button class="primary" data-trace-search>查询</button></div><button class="primary full" data-form="trace-event">＋ 新增溯源事件</button>${pageHead('质量溯源','每个批次对应一条可核查的数据链')}${body}</section>`
}
function renderMarket(){
 const products=state.data.products,demands=state.data.demands;
 return `<section class="page"><div class="toolbar"><button class="primary" data-form="product">＋ 发布供应</button><button class="secondary" data-form="demand">发布采购需求</button></div>${pageHead('供应信息','只展示后台已保存的真实供应数据')}${products.length?products.map(p=>`<div class="card list-card"><div class="row-top"><div class="product-row"><div class="product-icon">${p.icon?(p.icon.startsWith('http')||p.icon.startsWith('/')?`<img src="${esc(p.icon)}" alt="${esc(p.name)}">`:esc(p.icon)):'🍄'}</div><div><h3>${esc(p.name)}</h3><p>批次：${esc(batchCode(p.batch_id))} · 可售日期：${esc(dateOnly(p.available_date)||'未设置')}</p></div></div>${badge(p.status==='available'?'可供应':'已下架')}</div><div class="metric-line"><div><span>数量</span><b>${esc(p.quantity)} ${esc(p.unit)}</b></div><div><span>价格</span><b>¥${money(p.price)}</b></div><div><span>单位</span><b>${esc(p.unit)}</b></div></div><p class="meta">${esc(p.description||'暂无说明')}</p><div class="action-row"><button data-edit-icon="${p.id}">更换产品图标</button></div></div>`).join(''):empty('暂无供应信息','点击发布供应，保存真实产品、数量、价格和批次。')}
 ${pageHead('采购需求','采购商通过表单录入并保存到数据库')}${demands.length?demands.map(d=>`<div class="card list-card"><div class="row-top"><div><h3>${esc(d.buyer_name)}</h3><p>${esc(d.product_name)} · ${esc(d.quantity)} ${esc(d.unit)}</p></div>${badge('¥'+money(d.price))}</div><p class="meta">${esc(d.requirements||'暂无补充要求')}</p></div>`).join(''):empty('暂无采购需求','点击发布采购需求，保存真实采购方和产品需求。')}</section>`
}
function renderExpert(){
 const qs=state.data.questions;
 return `<section class="page"><div class="toolbar"><button class="primary" data-form="question">＋ 向专家提问</button><button class="secondary" data-page="home">返回首页</button></div>${pageHead('专家问答','问题与回答均保存到后台数据库')}${qs.length?qs.map(q=>`<div class="card list-card"><div class="row-top"><div><h3>${esc(q.title)}</h3><p>${esc(baseName(q.base_id))} · ${esc(q.category||'未分类')}</p></div>${badge(q.status==='answered'?'已回复':'待回复')}</div><p class="meta">${esc(q.content)}</p>${q.answer?`<div class="notice success" style="margin:10px 0 0">专家回复：${esc(q.answer)}</div>`:''}</div>`).join(''):empty('暂无专家问题','点击向专家提问，保存真实问题。')}</section>`
}
function render(){
 const titles=pageMeta[state.page]||pageMeta.home;
 $('#navTitle').textContent=titles[0];$('#navSub').textContent=titles[1];
 $$('.tabbar button').forEach(b=>b.classList.toggle('active',b.dataset.page===state.page));
 if(state.loading){$('#app').innerHTML='<div class="loading">正在读取后台数据...</div>';return}
 if(state.error){$('#app').innerHTML=`<section class="page"><div class="error"><b>后台连接失败</b><br>${esc(state.error)}<br><br>请在项目目录运行：<code>npm start</code>，然后访问 http://localhost:3000。</div></section>`;return}
 const renderers={home:renderHome,production:renderProduction,monitor:renderMonitor,trace:renderTrace,market:renderMarket,expert:renderExpert};
 $('#app').innerHTML=(renderers[state.page]||renderHome)();const renderedPage=$('#app .page');if(renderedPage)renderedPage.classList.add('active');
}

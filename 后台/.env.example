# 复制本文件为 .env，然后使用 npm run start:env 启动（Node 20.6+ 支持 --env-file）
# 注意：.env 不要提交到公开仓库

PORT=3000

# JWT 签名密钥。留空时后台会自动生成并保存到 server/data/jwt.secret，服务重启后已登录状态仍然有效
JWT_SECRET=

# AI 问答（OpenAI 兼容接口，可选）。未配置或调用失败时自动降级为规则知识库
# DeepSeek 示例：https://api.deepseek.com/v1 + deepseek-chat
# OpenAI 示例：https://api.openai.com/v1 + gpt-4o-mini
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# 微信小程序一键登录（可选）。在微信公众平台 → 开发管理 → 开发设置 中获取
# 未配置时小程序会提示「后台未配置微信小程序 AppID/Secret」，可改用账号密码登录
WX_APPID=
WX_SECRET=

# MQTT 设备接入（可选）。适配层：npm run mqtt；本地演示 broker：npm run mqtt:broker
# 生产环境把 MQTT_URL 指向 EMQX / Mosquitto 等正式 broker
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC_PREFIX=gushi
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BROKER_PORT=1883
